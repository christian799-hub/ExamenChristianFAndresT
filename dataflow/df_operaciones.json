{
	"name": "df_operaciones",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "OperacionesTabla",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "NormalizarNombreOperacion"
				},
				{
					"name": "NormalizarFecha"
				},
				{
					"name": "NormalizarNumeros"
				},
				{
					"name": "NormalizarCosto"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_operacion as integer,",
				"          id_tipo as integer,",
				"          id_unidad_resp as integer,",
				"          id_zona as integer,",
				"          nombre_operacion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          efectivos_desplegados as string,",
				"          vehiculos_utilizados as string,",
				"          duracion_dias as string,",
				"          costo_operacion as string,",
				"          resultado as string,",
				"          detenidos as string,",
				"          area_km2 as string,",
				"          incidentes as string,",
				"          observaciones as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(nombre_operacion = trim(\r",
				"    regexReplace(\r",
				"        regexReplace(\r",
				"            regexReplace(\r",
				"                regexReplace(\r",
				"                    trim(nombre_operacion),\r",
				"                    '[—–]', '-'                          \r",
				"                ),\r",
				"                '^(Op(eración)?\\\\.?\\\\s*)+', ''           \r",
				"            ),\r",
				"            '\\\\([^)]*?(\\\\d{4})[^)]*\\\\)', '$1'            \r",
				"        ),\r",
				"        '\\\\s+', ' '                                      \r",
				"    )\r",
				")) ~> NormalizarNombreOperacion",
				"NormalizarNombreOperacion derive(fecha_inicio = coalesce(\r",
				"    toDate(fecha_inicio, 'dd-MM-yyyy'),\r",
				"    toDate(fecha_inicio, 'dd/MM/yyyy'),\r",
				"    toDate(fecha_inicio, 'yyyy/MM/dd'),\r",
				"    toDate(fecha_inicio, 'yyyyMMdd'),\r",
				"    toDate(fecha_inicio, 'yyyy-MM-dd'),\r",
				"    toDate(fecha_inicio, 'MM-dd-yyyy'),\r",
				"    toDate(\r",
				"        replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(\r",
				"            lower(trim(fecha_inicio)),\r",
				"            'enero', '01'),\r",
				"            'febrero', '02'),\r",
				"            'marzo', '03'),\r",
				"            'abril', '04'),\r",
				"            'mayo', '05'),\r",
				"            'junio', '06'),\r",
				"            'julio', '07'),\r",
				"            'agosto', '08'),\r",
				"            'septiembre', '09'),\r",
				"            'octubre', '10'),\r",
				"            'noviembre', '11'),\r",
				"            'diciembre', '12'),\r",
				"            'ene', '01'),\r",
				"            'feb', '02'),\r",
				"            'mar', '03'),\r",
				"            'abr', '04'),\r",
				"            'may', '05'),\r",
				"            'jun', '06'),\r",
				"            'jul', '07'),\r",
				"            'ago', '08'),\r",
				"            'sep', '09'),\r",
				"            'oct', '10'),\r",
				"            'nov', '11'),\r",
				"            'dic', '12'),\r",
				"        'dd-MM-yyyy')\r",
				"    )\r",
				"),",
				"          fecha_fin = coalesce(\r",
				"    toDate(fecha_fin, 'dd-MM-yyyy'),\r",
				"    toDate(fecha_fin, 'dd/MM/yyyy'),\r",
				"    toDate(fecha_fin, 'yyyy/MM/dd'),\r",
				"    toDate(fecha_fin, 'yyyyMMdd'),\r",
				"    toDate(fecha_fin, 'yyyy-MM-dd'),\r",
				"    toDate(fecha_fin, 'MM-dd-yyyy'),\r",
				"    toDate(\r",
				"        replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(\r",
				"            lower(trim(fecha_fin)),\r",
				"            'enero', '01'),\r",
				"            'febrero', '02'),\r",
				"            'marzo', '03'),\r",
				"            'abril', '04'),\r",
				"            'mayo', '05'),\r",
				"            'junio', '06'),\r",
				"            'julio', '07'),\r",
				"            'agosto', '08'),\r",
				"            'septiembre', '09'),\r",
				"            'octubre', '10'),\r",
				"            'noviembre', '11'),\r",
				"            'diciembre', '12'),\r",
				"            'ene', '01'),\r",
				"            'feb', '02'),\r",
				"            'mar', '03'),\r",
				"            'abr', '04'),\r",
				"            'may', '05'),\r",
				"            'jun', '06'),\r",
				"            'jul', '07'),\r",
				"            'ago', '08'),\r",
				"            'sep', '09'),\r",
				"            'oct', '10'),\r",
				"            'nov', '11'),\r",
				"            'dic', '12'),\r",
				"        'dd-MM-yyyy')\r",
				"    )\r",
				")) ~> NormalizarFecha",
				"NormalizarFecha derive(efectivos_desplegados = toInteger(\r",
				"    iif(\r",
				"        lower(trim(efectivos_desplegados)) == 'cien', '100',\r",
				"    iif(\r",
				"        lower(trim(efectivos_desplegados)) == 'cincuenta', '50',\r",
				"    iif(\r",
				"        lower(trim(efectivos_desplegados)) == 'doscientos', '200',\r",
				"    iif(\r",
				"        lower(trim(efectivos_desplegados)) == 'trescientos', '300',\r",
				"    iif(\r",
				"        lower(trim(efectivos_desplegados)) == 'quinientos', '500',\r",
				"    iif(\r",
				"        lower(trim(efectivos_desplegados)) == 'ciento cincuenta', '150',\r",
				"\r",
				"        regexReplace(\r",
				"            lower(trim(efectivos_desplegados)),\r",
				"            '[^0-9]',\r",
				"            ''\r",
				"        )\r",
				"\r",
				"    ))))))\r",
				"),",
				"          vehiculos_utilizados = toInteger(     regexReplace(         lower(trim(vehiculos_utilizados)),         '[^0-9]',         ''     ) ),",
				"          duracion_dias = toInteger(     iif(         lower(trim(duracion_dias)) == 'veinte', '20',     iif(         lower(trim(duracion_dias)) == 'dieciseis', '16',     iif(         lower(trim(duracion_dias)) == 'dieciséis', '16',         regexReplace(             lower(trim(duracion_dias)),             '[^0-9]',             ''         )     ))) ),",
				"          detenidos = toInteger(     iif(         lower(trim(detenidos)) == 'sin detenidos', '0',     iif(         lower(trim(detenidos)) == 'ninguno', '0',     iif(         lower(trim(detenidos)) == 'cero', '0',     iif(         lower(trim(detenidos)) == 'veinte', '20',         regexReplace(             lower(trim(detenidos)),             '[^0-9]',             ''         )     )))) ),",
				"          incidentes = toInteger(     iif(         lower(trim(incidentes)) == 'sin incidentes', '0',     iif(         lower(trim(incidentes)) == 'ninguno', '0',     iif(         lower(trim(incidentes)) == 'n/a', '0',     iif(         lower(trim(incidentes)) == 'na', '0',         regexReplace(             lower(trim(incidentes)),             '[^0-9]',             ''         )     )))) ),",
				"          area_km2 = toInteger(     regexReplace(         lower(trim(area_km2)),         '[^0-9]',         ''     ) )) ~> NormalizarNumeros",
				"NormalizarNumeros derive(costo_operacion = toDecimal(     replace(         regexReplace(costo_operacion, '[^0-9,.-]', ''),         ',', ''     ),     18,     2 )) ~> NormalizarCosto",
				"NormalizarCosto sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}