{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "df-fa-ucb"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"AzureDataLakeStorage1\""
		},
		"BaseDeDatos_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"BaseDeDatos\""
		},
		"Destino_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"Destino\""
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://fuerzasarmadasdw.dfs.core.windows.net/"
		},
		"BaseDeDatos_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server02-fuerzas-armadas-bolivia.database.windows.net"
		},
		"BaseDeDatos_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp-fuerzas-armadas-bolivia-2"
		},
		"BaseDeDatos_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "userSisGer"
		},
		"Destino_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server02-fuerzas-armadas-dw.database.windows.net"
		},
		"Destino_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw-fuerzas-armadas-bolivia"
		},
		"Destino_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin2"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-fa-ucb_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"BaseDeDatos_password": {
						"value": "[parameters('BaseDeDatos_password')]"
					},
					"Destino_password": {
						"value": "[parameters('Destino_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"BaseDeDatos_properties_typeProperties_server": {
						"value": "[parameters('BaseDeDatos_properties_typeProperties_server')]"
					},
					"BaseDeDatos_properties_typeProperties_database": {
						"value": "[parameters('BaseDeDatos_properties_typeProperties_database')]"
					},
					"BaseDeDatos_properties_typeProperties_userName": {
						"value": "[parameters('BaseDeDatos_properties_typeProperties_userName')]"
					},
					"Destino_properties_typeProperties_server": {
						"value": "[parameters('Destino_properties_typeProperties_server')]"
					},
					"Destino_properties_typeProperties_database": {
						"value": "[parameters('Destino_properties_typeProperties_database')]"
					},
					"Destino_properties_typeProperties_userName": {
						"value": "[parameters('Destino_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "df-fa-ucb_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'df-fa-ucb_ArmTemplate_0')]"
			]
		},
		{
			"name": "df-fa-ucb_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'df-fa-ucb_ArmTemplate_1')]"
			]
		},
		{
			"name": "df-fa-ucb_ArmTemplate_3",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_3.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'df-fa-ucb_ArmTemplate_2')]"
			]
		}
	]
}