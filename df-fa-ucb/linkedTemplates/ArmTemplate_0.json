			"defaultValue": "sql-fa-dw-ca.database.windows.net"
		},
		"Destino_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "fuerzas-armadas-ca"
		},
		"Destino_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin2"
		}
